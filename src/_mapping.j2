{%- import "src/_uuids.j2" as uuids with context -%}
{%- set isReferenceFIP = ctx.knowledgeModelPackage.kmId == 'reference-fip' -%}
{#- METADATA -#}
{#- community (Integration question) -#}
{%- set communityReply = repliesMap[uuids.communityPath] -%}
{%- set communityName = "" -%}
{%- set communityURI = "" -%}
{%- if communityReply and communityReply.value.value.value -%}
{%- if communityReply.value.value.type == 'IntegrationType' -%}
    {%- set communityURI = communityReply.value.value.raw.thing.value -%}
    {%- set communityName = communityReply.value.value.raw.label.value -%}
{%- elif communityReply.value.value.value.startswith('http') -%}
    {%- set communityURI = communityReply.value.value.value -%}
{%- else -%}
    {%- set communityName = communityReply.value.value.value -%}
{%- endif -%}
{%- endif -%}
{#- data stewards (List + Integration question) -#}
{%- set dataStewards = [] -%}
{%- set dataStewardItems = repliesMap[uuids.dataStewardsPath]|reply_items -%}
{%- for item in dataStewardItems -%}
    {%- set dataStewardPath = [uuids.dataStewardsPath, item, uuids.dataStewardOrcidQUuid]|reply_path -%}
    {%- set dataStewardOrcid = repliesMap[dataStewardPath]|reply_str_value -%}
    {%- do dataStewards.append(dataStewardOrcid) -%}
{%- endfor -%}
{#- DO type (Integration question) -#}
{%- set doTypeReply = repliesMap[uuids.doTypePath] -%}
{%- set doTypeName = "" -%}
{%- set doTypeURI = "" -%}
{%- if doTypeReply and doTypeReply.value.value.value -%}
{%- if doTypeReply.value.value.type == 'IntegrationType' -%}
    {%- set doTypeURI = doTypeReply.value.value.raw.thing.value -%}
    {%- set doTypeName = doTypeReply.value.value.raw.label.value -%}
{%- elif doTypeReply.value.value.value.startswith('http') -%}
    {%- set doTypeURI = doTypeReply.value.value.value -%}
{%- else -%}
    {%- set doTypeName = doTypeReply.value.value.value -%}
{%- endif -%}
{%- endif -%}
{#- DO URL (Value question) -#}
{%- set doUrl = repliesMap[uuids.doUrlPath]|reply_str_value -%}
{#- Case Study (Integration question) -#}
{%- set caseStudyReply = repliesMap[uuids.caseStudyPath] -%}
{%- set caseStudyName = "" -%}
{%- set caseStudyURI = "" -%}
{%- if caseStudyReply and caseStudyReply.value.value.value -%}
{%- if caseStudyReply.value.value.type == 'IntegrationType' -%}
    {%- set caseStudyURI = caseStudyReply.value.value.raw.thing.value -%}
    {%- set caseStudyName = caseStudyReply.value.value.raw.label.value -%}
{%- elif caseStudyReply.value.value.value.startswith('http') -%}
    {%- set caseStudyURI = caseStudyReply.value.value.value -%}
{%- else -%}
    {%- set caseStudyName = caseStudyReply.value.value.value -%}
{%- endif -%}
{%- endif -%}
{#- version (Value question) -#}
{%- set version = repliesMap[uuids.versionPath]|reply_str_value -%}

{%- set metadata = {
    'pubDate': ctx.document.createdAt,
    'communityName': communityName,
    'communityURI': communityURI,
    'dataStewards': dataStewards,
    'doTypeName': doTypeName,
    'doTypeURI': doTypeURI,
    'doUrl': doUrl,
    'caseStudyName': caseStudyName,
    'caseStudyURI': caseStudyURI,
    'version': version,
} -%}

{#- DATA -#}
{%- set declarations = [] -%}
{%- for q in uuids.questions -%}
    {%- set declarationsPath = [q.chapterUuid, q.questionUuid, q.answerUuid, q.declarationsUuid]|reply_path -%}
    {%- set declarationItems = repliesMap[declarationsPath]|reply_items -%}
    {%- for item in declarationItems -%}
        {%- set itemPath = [declarationsPath, item]|reply_path -%}
        {%- set resourceReply = repliesMap[[itemPath, q.resourceUuid]|reply_path] -%}
        {%- set replacementReply = repliesMap[[itemPath, q.choiceUuid, q.replaceUuid, q.replacementUuid]|reply_path] -%}
        {%- set choiceUuid = repliesMap[[itemPath, q.choiceUuid]|reply_path]|reply_str_value -%}
        {%- set considerations = repliesMap[[itemPath, q.considerationsUuid]|reply_path]|reply_str_value -%}
        {%- if resourceReply and (choiceUuid or isReferenceFIP) -%}
            {%- set resourceName = "" -%}
            {%- set resourceURI = "" -%}
            {%- set replacementName = "" -%}
            {%- set replacementURI = "" -%}
            {%- set choice = "" -%}

            {#- resource -#}
            {%- if resourceReply and resourceReply.value.value.value -%}
            {%- if resourceReply.value.value.type == 'IntegrationType' -%}
                {%- set resourceURI = resourceReply.value.value.raw.thing.value -%}
                {%- set resourceName = resourceReply.value.value.raw.label.value -%}
            {%- elif resourceReply.value.value.value.startswith('http') -%}
                {%- set resourceURI = resourceReply.value.value.value -%}
            {%- else -%}
                {%- set resourceName = resourceReply.value.value.value -%}
            {%- endif -%}
            {%- endif -%}

            {#- choice -#}
            {%- if choiceUuid == q.currentUuid -%}
                {%- set choice = "currently in use" -%}
            {%- elif choiceUuid == q.replaceUuid -%}
                {%- set choice = "to be replaced" -%}

                {#- replacement -#}
                {%- if replacementReply and replacementReply.value.value.value -%}
                {%- if replacementReply.value.value.type == 'IntegrationType' -%}
                    {%- set replacementURI = replacementReply.value.value.raw.thing.value -%}
                    {%- set replacementName = replacementReply.value.value.raw.label.value -%}
                {%- elif replacementReply.value.value.value.startswith('http') -%}
                    {%- set replacementURI = replacementReply.value.value.value -%}
                {%- else -%}
                    {%- set replacementName = replacementReply.value.value.value -%}
                {%- endif -%}
                {%- endif -%}
            {%- elif choiceUuid == q.plannedUuid -%}
                {%- set choice = "planned use" -%}
            {%- endif -%}

            {%- do declarations.append({
                'question': q.question,
                'note': km.entities.questions[q.questionUuid].title,
                'resourceName': resourceName,
                'resourceURI': resourceURI,
                'choice': choice,
                'replacementName': replacementName,
                'replacementURI': replacementURI,
                'considerations': considerations
            }) -%}
        {%- endif -%}
    {%- endfor -%}
{%- endfor -%}
